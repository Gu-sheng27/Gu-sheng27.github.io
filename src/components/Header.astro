---
import { site } from '../site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="wrap pt-10 pb-4 sm:pt-14">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <a href="/" class="meta tracking-[0.14em] transition-colors hover:text-ink">
      {site.author}
    </a>

    <nav aria-label="Main" class="flex items-center gap-5 text-[0.95rem] sm:gap-7">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="text-ink-muted transition-colors hover:text-ink aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>