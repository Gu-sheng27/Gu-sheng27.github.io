---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <p class="meta">Error 404</p>
  <h1 class="mt-2 text-[1.6rem] tracking-tight">This page does not exist.</h1>
  <p class="mt-3 text-ink-muted">
    The link may be out of date, or the page may have never existed. Try the
    <a href="/" class="link">home page</a> or everything under
    <a href="/writing/" class="link">writing</a>.
  </p>
</BaseLayout>